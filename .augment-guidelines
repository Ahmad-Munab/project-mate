{
  "_comment": "These guidelines are designed to ensure code quality, maintainability, a stable build process, and learning opportunities through thorough explanations and comments in the generated code.",
  "git": {
    "git_commits": "Always commit changes with clear and concise messages and add 'Amaan - (you're commit message) make commits like that'"
  },
  "code_quality": {
    "type_safe": true,
    "eslint_errors": true,
    "avoid_redundant_code": true,
    "no_unnecessary_libraries": true,
    "modular_and_maintainable": true,
    "explanations_in_comments": true,
    "avoid_redundant_code_files": true,
    "no_code_smells": true,
    "follow_best_practices_for_scalability": true,
