  "code_structure": {
    "limit_file_size_to_200_400_lines": true,
    "focus_on_modularization": true,
    "split_large_components_or_files": true,
    "ensure_scalability_by_modular_code": true,
    "avoid_large_monolithic_files": true,
    "create_small_but_reusable_code_fragments": true,
    "split_large_logic_into_smaller_modules": true,
    "refactor_complex_code_to_be_more_readable": true,
    "maintain_clarity_with_small_functions": true,
    "optimize_for_long_term_maintenance": true
  },

  "folder_structure": {
    "/types": "Contains type definitions and validation schemas using Zod.",
    "/store": "Holds state management logic using Zustand.",
    "/components": "UI components for the application.",
    "/utils": "Helper functions and utility modules."
  },

  "type_safety": {
    "use_zod_for_validation": true,
    "types_in_types_folder": true,
    "typesafety_for_all_api_responses": true
  },


  "dependencies_management": {
    "fit_existing_package_json": true,
    "no_unnecessary_libraries": true,
    "use_zod_and_zustand": true,
    "only_add_libraries_when_necessary": true
  },

  "testing_and_build": {
