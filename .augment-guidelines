    "ensure_tests_coverage": true,
    "ensure_no_errors_during_build": true
  },

  "state_management": {
    "zustand_for_state_management": true,
    "keep_states_in_store_folder": true
  },

  "code_explanation": {
    "explain_changes_in_comments": true,
    "add_documentation_for_files_and_important_functions": true,
    "keep_comments_clear_and_understandable": true,
    "add_context_for_logic_changes": true,
    "add_explanations_for_code_decisions": true,
    "ensure_comments_are_informative": true,
    "explain_purpose_of_functions_and_modules": true,
    "comment_significant_changes_for_education": true
  },

  "folder_structure_guidelines": {
    "types_folder": "Store type definitions and validation schemas using Zod.",
    "store_folder": "Manage application state using Zustand.",
    "components_folder": "Develop reusable UI components.",
    "pages_folder": "Define routing and page components in Next.js.",
    "utils_folder": "Implement helper functions and utilities."
  },

